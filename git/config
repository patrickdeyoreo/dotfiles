# ~/.config/git/config: user-global git config
# see git(1) git-config(1)

[include]
	path = ~/.local/share/git/config/user.gitconfig

[core]
	editor = nvim
	excludesFile = ~/.config/git/ignore
	ignoreCase = false

[init]
	defaultBranch = main
	templateDir = ~/.local/share/git/templates

[credential]
	helper = cache --timeout 3600

[push]
	default = current
	autoSetupRemote = true

[pull]
	rebase = false

[color]
	ui = auto

[color "decorate"]
	branch = blue
	remoteBranch = magenta
	stash = red
	tag = yellow

[color "diff"]
	meta = cyan
	frag = magenta
	old = red
	new = green

[alias]
	# Fix lines like `git git ...`
	git = "!git"

	# Run lazygit
	lazy = "!lazygit"

	a = add
	aa = add -A

	c = commit
	cm = commit -m

	r = remote
	rv = remote -v

	b = branch
	ba = branch -a
	bd = branch -d

	co = checkout
	cob = checkout -b

	m = merge
	ma = merge --abort
	mc = merge --continue

	st = status
	sts = status --short --branch

	sw = switch
	swc = switch --create

	sub = submodule

	# Commit history
	l = log --all --graph --decorate --oneline
	ll = log --stat --abbrev-commit

	# List of contributors with commit totals
	contrib = shortlog -sn

	# Amend last commit with its original message
	amend = "!__git_amend() { git log -n 1 --pretty=tformat:%s%n%n%b | git commit -F - --amend; }; __git_amend"

	# Initialize, add all files and commit
	new = "!__git_new() { git init && touch README.md && git add -A && git commit -m \"Initial commit\"; }; __git_new"

	# Pull from remote and push from local
	sync = "!__git_sync() { git pull && git push; }; __git_sync"

	# Checkout and pull
	dev = "!__git_dev() { git checkout dev && git pull --prune; }; __git_dev"
	develop = "!__git_develop() { git checkout develop && git pull --prune; }; __git_develop"
	uat = "!__git_uat() { git checkout uat && git pull --prune; }; __git_uat"
	staging = "!__git_staging() { git checkout staging && git pull --prune; }; __git_staging"
	master = "!__git_master() { git checkout master && git pull --prune; }; __git_master"
	main = "!__git_main() { git checkout main && git pull --prune; }; __git_main"

