{
  "mcpServers": {
    "AWS Documentation": {
      "args": [
        "awslabs.aws-documentation-mcp-server@1.1.21"
      ],
      "command": "uvx",
      "env": {
        "AWS_DOCUMENTATION_PARTITION": "aws",
        "FASTMCP_LOG_LEVEL": "WARNING"
      }
    },
    "Context7": {
      "env": {
        "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY}"
      },
      "headers": {
        "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY}"
      },
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    },
    "Homebrew": {
      "args": [
        "mcp-server"
      ],
      "command": "brew"
    },
    "atlassian": {
      "args": [
        "mcp-atlassian@0.21.1"
      ],
      "command": "uvx",
      "env": {
        "JIRA_API_TOKEN": "${ATLASSIAN_API_TOKEN}",
        "JIRA_URL": "${ATLASSIAN_URL}",
        "JIRA_USERNAME": "${ATLASSIAN_USERNAME}",
        "CONFLUENCE_API_TOKEN": "${ATLASSIAN_API_TOKEN}",
        "CONFLUENCE_URL": "${ATLASSIAN_URL}/wiki",
        "CONFLUENCE_USERNAME": "${ATLASSIAN_USERNAME}"
      }
    },
    "browser_tools": {
      "args": [
        "@agentdeskai/browser-tools-mcp@latest"
      ],
      "command": "npx"
    },
    "cloudwatch": {
      "args": [
        "awslabs.cloudwatch-mcp-server@0.0.26"
      ],
      "command": "uvx",
      "env": {
        "AWS_REGION": "${AWS_REGION}",
        "FASTMCP_LOG_LEVEL": "WARNING"
      }
    },
    "dynamodb": {
      "args": [
        "awslabs.dynamodb-mcp-server@2.1.1"
      ],
      "command": "uvx",
      "env": {
        "AWS_REGION": "${AWS_REGION}",
        "FASTMCP_LOG_LEVEL": "WARNING"
      }
    },
    "fetch": {
      "args": [
        "mcp-server-fetch@2025.4.7"
      ],
      "command": "uvx"
    },
    "filesystem": {
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "${HOME}/Documents"
      ],
      "command": "npx",
      "env": {}
    },
    "github": {
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_PERSONAL_ACCESS_TOKEN}"
      },
      "headers": {
        "Authorization": "Bearer ${GITHUB_PERSONAL_ACCESS_TOKEN}"
      },
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/"
    },
    "lambda": {
      "args": [
        "awslabs.lambda-tool-mcp-server@2.0.17"
      ],
      "command": "uvx",
      "env": {
        "AWS_REGION": "${AWS_REGION}",
        "FASTMCP_LOG_LEVEL": "WARNING"
      }
    },
    "memory": {
      "args": [
        "-y",
        "@modelcontextprotocol/server-memory"
      ],
      "command": "npx"
    },
    "puppeteer": {
      "args": [
        "-y",
        "@modelcontextprotocol/server-puppeteer"
      ],
      "command": "npx"
    },
    "sequentialthinking": {
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "command": "npx"
    },
    "slack": {
      "args": [
        "-y",
        "@modelcontextprotocol/server-slack"
      ],
      "command": "npx",
      "env": {
        "SLACK_BOT_TOKEN": "${SLACK_BOT_TOKEN}",
        "SLACK_CHANNEL_IDS": "${SLACK_CHANNEL_IDS}",
        "SLACK_TEAM_ID": "${SLACK_TEAM_ID}"
      }
    },
    "task_master": {
      "args": [
        "-y",
        "--package=task-master-ai",
        "task-master-ai"
      ],
      "command": "npx",
      "env": {
        "ANTHROPIC_API_KEY": "${ANTHROPIC_API_KEY}",
        "AZURE_OPENAI_API_KEY": "${AZURE_OPENAI_API_KEY}",
        "CLAUDE_CODE_OAUTH_TOKEN": "${CLAUDE_CODE_OAUTH_TOKEN}",
        "GOOGLE_API_KEY": "${GOOGLE_API_KEY}",
        "MISTRAL_API_KEY": "${MISTRAL_API_KEY}",
        "OLLAMA_API_KEY": "${OLLAMA_API_KEY}",
        "OPENAI_API_KEY": "${OPENAI_API_KEY}",
        "OPENROUTER_API_KEY": "${OPENROUTER_API_KEY}",
        "PERPLEXITY_API_KEY": "${PERPLEXITY_API_KEY}",
        "XAI_API_KEY": "${XAI_API_KEY}"
      }
    },
    "time": {
      "args": [
        "mcp-server-time@2026.1.26"
      ],
      "command": "uvx"
    }
  }
}
